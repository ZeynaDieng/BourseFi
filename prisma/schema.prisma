generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactVerificationStatus {
  VERIFIED
  TO_VERIFY
  UNVERIFIED
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
  WEBSITE
}

enum ContactSource {
  OFFICIAL_WEBSITE
  ESTABLISHMENT
  DIRECTORY
  OTHER
}

enum TarifSource {
  OFFICIAL_WEBSITE
  ESTABLISHMENT
  DOCUMENT
  PARTNER
  OTHER
}

model Partner {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  logoUrl             String?
  contactEmail        String?
  partnerSharePercent Int           @default(75)
  createdAt           DateTime      @default(now())
  conditions          String?
  description         String?
  bourses             Bourse[]
  candidatures        Candidature[]
  programmes          Programme[]
  users               User[]
}

model Etablissement {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  nom               String
  ville             String
  accreditation     String?
  site              String?
  resume            String?
  coverImageUrl     String?
  logoUrl           String?
  typeLabel         String?
  adresse           String?
  phone             String?
  phoneSecondary    String?
  whatsapp          String?
  email             String?
  status            EntityStatus              @default(ACTIVE)
  source            ContactSource?
  contactStatus     ContactVerificationStatus @default(TO_VERIFY)
  contactVerifiedAt DateTime?
  isDirectPartner      Boolean                   @default(false)
  fraisDossier         Int                       @default(20000)
  autoIssueAttestation Boolean                   @default(false)
  commissionType       String                    @default("FIXED_AMOUNT")
  commissionValue      Int                       @default(0)
  commissionPaidStatus String                    @default("UP_TO_DATE")
  updatedBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  programmes        Programme[]
  contacts          EtablissementContact[]
}

model EtablissementContact {
  id              String                    @id @default(cuid())
  etablissementId String
  type            ContactType
  valeur          String
  label           String?
  isPrincipal     Boolean                   @default(false)
  isWhatsapp      Boolean                   @default(false)
  status          ContactVerificationStatus @default(TO_VERIFY)
  source          ContactSource?
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  etablissement   Etablissement             @relation(fields: [etablissementId], references: [id], onDelete: Restrict)

  @@index([etablissementId])
}

model Programme {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  etablissementId      String
  partnerId            String
  titre                String
  ville                String
  duree                String
  fraisDossier         Int?
  fraisDossierEtranger Int?          @default(30000)
  devise               String        @default("FCFA")
  niveau               String
  placement            String?
  description          String
  eligibilite          String?
  brochureUrl          String?
  perspectives         String?
  objectifs            String?
  competences          String?
  programmePedagogique String?
  debouches            String?
  secteurs             String?
  conditionsAdmission  String?
  documentsRequis      String?
  modalites            String?
  stage                String?
  examens              String?
  poursuiteEtudes      String?
  sourceType           String?
  sourceUrl            String?
  verifiedAt           DateTime?
  metaTitle            String?
  metaDescription      String?
  ogImageUrl           String?
  status               EntityStatus  @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bourses              Bourse[]
  candidatures         Candidature[]
  tarifs               Tarif[]
  etablissement        Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  partner              Partner       @relation(fields: [partnerId], references: [id])
}

model Tarif {
  id               String       @id @default(cuid())
  programmeId      String
  anneeAcademique  String
  montant          Int
  montantBourse    Int?
  fraisInscription Int?
  mensualite       Int?
  nombreMois       Int?         @default(10)
  fraisSoutenance  Int?
  fraisUniforme    Int?
  autresFrais      Int?
  frequence        String       @default("ANNUEL")
  devise           String       @default("FCFA")
  label            String?
  isDefault        Boolean      @default(true)
  source           TarifSource?
  isVerified       Boolean      @default(false)
  verifiedAt       DateTime?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  updatedBy        String?
  programme        Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId, anneeAcademique])
}

model Bourse {
  id              String        @id @default(cuid())
  slug            String        @unique
  titre           String
  programmeId     String
  partnerId       String
  coveragePercent Int
  montantMax      Int?
  quota           Int           @default(0)
  placesRestantes Int           @default(0)
  dateDebut       DateTime?
  dateLimite      DateTime
  conditions      String?
  documentsRequis String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isActive        Boolean       @default(true)
  status          EntityStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  partner         Partner       @relation(fields: [partnerId], references: [id])
  programme       Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  candidatures    Candidature[]

  @@index([programmeId])
  @@index([partnerId])
  @@index([isActive])
  @@index([status])
}

model User {
  id                     String         @id @default(cuid())
  name                   String
  email                  String         @unique
  passwordHash           String
  role                   Role           @default(STUDENT)
  partnerId              String?
  emailVerified          Boolean        @default(false)
  emailVerificationToken String?        @unique
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  address                String?
  firstName              String?
  identityCardRectoUrl   String?
  identityCardVersoUrl   String?
  bfemAttestationUrl     String?
  bacTranscriptUrl       String?
  lastName               String?
  phone                  String?
  auditLogs              AuditLog[]
  candidatures           Candidature[]
  notifications          Notification[]
  paiements              Paiement[]
  sessions               Session[]
  partner                Partner?       @relation(fields: [partnerId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Candidature {
  id                   String            @id @default(cuid())
  userId               String
  programmeId          String
  partnerId            String
  firstName            String            @default("")
  lastName             String            @default("")
  fullName             String
  email                String
  phone                String            @default("")
  address              String            @default("")
  institution          String            @default("")
  field                String            @default("")
  level                String            @default("Non precise")
  lastEducationLevel   String            @default("")
  lastDiploma          String            @default("")
  graduationDate       String            @default("")
  gpa                  String            @default("")
  targetProgram        String
  status               CandidatureStatus @default(SOUMIS)
  commissionAmount     Int               @default(0)
  commissionStatus     String            @default("EN_ATTENTE")
  commissionPaidAt     DateTime?
  commissionRef        String?
  commissionNotes      String?
  attestationNumber    String?           @unique
  attestationIssuedAt  DateTime?
  attestationUrl       String?
  documentUrl          String?
  documentIssuedAt     DateTime?
  identityCardRectoUrl String?
  identityCardVersoUrl String?
  bfemAttestationUrl   String?
  bacTranscriptUrl     String?
  montantInitial       Int?
  montantReduction     Int?
  montantFinal         Int?
  promoCodeId          String?
  interestLevel        InterestLevel?    @default(HOT_MED)
  blockingReason       BlockingReason?
  relanceCount         Int               @default(0)
  lastRelanceAt        DateTime?
  lastChannelUsed      String?
  nextRelanceAt        DateTime?
  conversionScore      Int               @default(75)
  autoRelanceStep      Int               @default(0)
  lastAutoRelanceAt    DateTime?
  isLost               Boolean           @default(false)
  engagementScore      Int               @default(50)
  emailRelanceStep     Int               @default(0)
  lastEmailRelanceAt   DateTime?
  segment              String?
  promoCode            PromoCode?        @relation(fields: [promoCodeId], references: [id])
  createdAt            DateTime          @default(now())
  bourseId             String?
  bourse               Bourse?           @relation(fields: [bourseId], references: [id])
  partner              Partner           @relation(fields: [partnerId], references: [id])
  programme            Programme         @relation(fields: [programmeId], references: [id])
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paiement             Paiement?
  crmNotes             CandidatureNote[]
  autoRelanceLogs      AutoRelanceLog[]
  emailLogs            EmailRelanceLog[]

  @@index([partnerId])
  @@index([programmeId])
  @@index([bourseId])
  @@index([promoCodeId])
  @@index([status])
  @@index([interestLevel])
  @@index([nextRelanceAt])
}

enum InterestLevel {
  HOT_HIGH
  HOT_MED
  WARM
  COLD
  NOT_INTERESTED
}

enum BlockingReason {
  PARENT_APPROVAL
  FINANCIAL_DIFFICULTY
  MISSING_DOCS
  SCHOOL_HESITATION
  PROGRAM_HESITATION
  TECHNICAL_ISSUE
  WAITING_RESPONSE
  NO_LONGER_INTERESTED
  EXPIRED
  OTHER
}

enum ExchangeType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SUPPORT
  OTHER
}

enum NextAction {
  CALL_TOMORROW
  SEND_BROCHURE
  SEND_PROMO
  SEND_PAYMENT_LINK
  WAIT_CANDIDATE
  SCHEDULE_MEETING
  VERIFY_DOCS
}

model CandidatureNote {
  id             String          @id @default(cuid())
  candidatureId  String
  agentName      String          @default("Admin BourseFi")
  exchangeType   ExchangeType    @default(WHATSAPP)
  content        String
  interestLevel  InterestLevel?
  blockingReason BlockingReason?
  nextAction     NextAction?
  nextRelanceAt  DateTime?
  isPinned       Boolean         @default(false)
  attachmentUrl  String?
  createdAt      DateTime        @default(now())

  candidature    Candidature     @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@index([nextRelanceAt])
}

enum PromoType {
  PERCENTAGE
  FIXED
}

model PromoCode {
  id              String        @id @default(cuid())
  code            String        @unique @db.VarChar(50)
  type            PromoType
  valeur          Float
  maxUses         Int?
  usedCount       Int           @default(0)
  expiresAt       DateTime?
  isActive        Boolean       @default(true)
  etablissementId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  candidatures    Candidature[]

  @@index([code])
  @@index([etablissementId])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  body          String
  readAt        DateTime?
  candidatureId String?
  bourseId      String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model Paiement {
  id             String       @id @default(cuid())
  userId         String
  candidatureId  String?      @unique
  fullName       String
  email          String
  phone          String
  method         String
  amount         Int
  amountPartner  Int          @default(0)
  amountPlatform Int          @default(0)
  currency       String
  status         String       @default("EN_ATTENTE")
  createdAt      DateTime     @default(now())
  provider       String?      @default("paytech")
  refCommand     String?      @unique
  token          String?
  candidature    Candidature? @relation(fields: [candidatureId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}

model SiteContent {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)
  question  String
  answer    String
}

model TestimonialItem {
  id            String  @id @default(cuid())
  sortOrder     Int     @default(0)
  published     Boolean @default(true)
  initials      String?
  name          String
  role          String
  quote         String
  avatarUrl     String?
  ecoleNom      String?
  partenaireNom String?
}

model MetierPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  label            String
  shortDescription String
  salary           String
  employability    String
  salaryNote       String
  missions         Json
  skills           Json
  career           Json
  coverImageUrl    String?
  updatedAt        DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  senderName String
  email      String
  subject    String
  message    String
  createdAt  DateTime @default(now())
}

enum Role {
  STUDENT
  ADMIN
  PARTNER
}

enum CandidatureStatus {
  SOUMIS
  EN_ATTENTE_PAIEMENT
  EN_REVUE_PARTENAIRE
  COMPLEMENT_DEMANDE
  ACCEPTE
  REFUSE
  DOCUMENT_EMIS
  BROUILLON
  TERMINE
}

model AutoRelanceRule {
  id              String   @id @default(cuid())
  name            String
  scenarioStep    Int      @unique
  triggerHours    Int
  channel         String   @default("BOTH")
  codePromo       String?
  messageTemplate String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutoRelanceLog {
  id              String      @id @default(cuid())
  candidatureId   String
  scenarioStep    Int
  channel         String
  status          String      @default("SENT")
  convertedAt     DateTime?
  recoveredAmount Int?
  sentAt          DateTime    @default(now())
  candidature     Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@index([sentAt])
}

model EmailTemplate {
  id           String            @id @default(cuid())
  name         String
  subject      String
  bodyHtml     String
  bodyText     String?
  scenarioStep Int?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  logs         EmailRelanceLog[]
}

model EmailRelanceLog {
  id              String         @id @default(cuid())
  candidatureId   String
  templateId      String?
  subject         String
  status          String         @default("SENT") // SENT, DELIVERED, OPENED, CLICKED, CONVERTED
  opensCount      Int            @default(0)
  clicksCount     Int            @default(0)
  convertedAt     DateTime?
  recoveredAmount Int?
  sentAt          DateTime       @default(now())
  candidature     Candidature    @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([candidatureId])
  @@index([templateId])
  @@index([sentAt])
  @@index([status])
}
