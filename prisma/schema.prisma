generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  logoUrl             String?
  contactEmail        String?
  /// Part du montant total (0-100) attribuee au partenaire bailleur
  partnerSharePercent Int           @default(75)
  createdAt           DateTime      @default(now())
  conditions          String?
  description         String?
  bourses             Bourse[]
  candidatures        Candidature[]
  programmes          Programme[]
  users               User[]
}

model Etablissement {
  id            String      @id @default(cuid())
  slug          String      @unique
  nom           String
  ville         String
  accreditation String?
  site          String?
  resume        String?
  /// Photo d’en-tête (carte + hero fiche école)
  coverImageUrl String?
  /// Logo affiché en pastille sur la photo
  logoUrl       String?
  /// Libellé métier du référentiel (ex. École d’ingénieur)
  typeLabel     String?
  programmes    Programme[]
}

model Programme {
  id              String        @id @default(cuid())
  slug            String        @unique
  etablissementId String
  partnerId       String
  titre           String
  ville           String
  duree           String
  fraisDossier    Int           @default(0)
  fraisDossierEtranger   Int?
  devise          String        @default("FCFA")
  niveau          String
  placement       String?
  description     String
  eligibilite     String?
  brochureUrl     String?
  perspectives    String?
  bourses         Bourse[]
  candidatures    Candidature[]
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  partner         Partner       @relation(fields: [partnerId], references: [id])
}

model Bourse {
  id              String        @id @default(cuid())
  slug            String        @unique
  titre           String
  programmeId     String
  partnerId       String
  coveragePercent Int
  montantMax      Int?
  quota           Int           @default(0)
  placesRestantes Int           @default(0)
  dateLimite      DateTime
  conditions      String?
  documentsRequis String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  partner         Partner       @relation(fields: [partnerId], references: [id])
  programme       Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  candidatures    Candidature[]

  @@index([programmeId])
  @@index([partnerId])
  @@index([isActive])
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  passwordHash         String
  role                 Role           @default(STUDENT)
  partnerId            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  address              String?
  firstName            String?
  identityCardRectoUrl String?
  identityCardVersoUrl String?
  lastName             String?
  phone                String?
  auditLogs            AuditLog[]
  candidatures         Candidature[]
  notifications        Notification[]
  paiements            Paiement[]
  sessions             Session[]
  partner              Partner?       @relation(fields: [partnerId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Candidature {
  id                   String            @id @default(cuid())
  userId               String
  programmeId          String
  partnerId            String
  firstName            String            @default("")
  lastName             String            @default("")
  fullName             String
  email                String
  phone                String            @default("")
  address              String            @default("")
  institution          String            @default("")
  field                String            @default("")
  level                String            @default("Non precise")
  lastEducationLevel   String            @default("")
  lastDiploma          String            @default("")
  graduationDate       String            @default("")
  gpa                  String            @default("")
  targetProgram        String
  status               CandidatureStatus @default(SOUMIS)
  documentUrl          String?
  documentIssuedAt     DateTime?
  identityCardRectoUrl String?
  identityCardVersoUrl String?
  bfemAttestationUrl   String?
  bacTranscriptUrl     String?
  createdAt            DateTime          @default(now())
  bourseId             String?
  bourse               Bourse?           @relation(fields: [bourseId], references: [id])
  partner              Partner           @relation(fields: [partnerId], references: [id])
  programme            Programme         @relation(fields: [programmeId], references: [id])
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paiement             Paiement?

  @@index([partnerId])
  @@index([programmeId])
  @@index([bourseId])
  @@index([status])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  body          String
  readAt        DateTime?
  candidatureId String?
  bourseId      String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model Paiement {
  id             String       @id @default(cuid())
  userId         String
  candidatureId  String?      @unique
  fullName       String
  email          String
  phone          String
  method         String
  amount         Int
  amountPartner  Int          @default(0)
  amountPlatform Int          @default(0)
  currency       String
  status         String       @default("Valide")
  createdAt      DateTime     @default(now())
  provider       String?      @default("paytech")
  refCommand     String?      @unique
  token          String?
  candidature    Candidature? @relation(fields: [candidatureId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}

/// Blocs JSON éditables (hero, sections landing, visuels globaux, etc.)
model SiteContent {
  key       String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)
  question  String
  answer    String
}

model TestimonialItem {
  id            String  @id @default(cuid())
  sortOrder     Int     @default(0)
  published     Boolean @default(true)
  initials      String?
  name          String
  role          String
  quote         String
  avatarUrl     String?
  ecoleNom      String?
  partenaireNom String?
}

/// Fiches guide métier  (remplace le contenu statique côté affichage)
model MetierPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  label            String
  shortDescription String
  salary           String
  employability    String
  salaryNote       String
  missions         Json
  skills           Json
  career           Json
  coverImageUrl    String?
  updatedAt        DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  senderName String
  email      String
  subject    String
  message    String
  createdAt  DateTime @default(now())
}

enum Role {
  STUDENT
  ADMIN
  PARTNER
}

enum CandidatureStatus {
  SOUMIS
  EN_ATTENTE_PAIEMENT
  EN_REVUE_PARTENAIRE
  COMPLEMENT_DEMANDE
  ACCEPTE
  REFUSE
  DOCUMENT_EMIS
  BROUILLON
  TERMINE
}
